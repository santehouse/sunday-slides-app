# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Toronto
CRON_SECRET=
# Signs the Sunday session cookie (32+ random chars)
SUNDAY_SESSION_SECRET=
# Set to 1 to run the UI against in-memory mock data (no Supabase needed)
CP_MOCK_DATA=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=church-panels
R2_ENDPOINT=
# Optional public base URL (custom domain or r2.dev) for permanent objects
R2_PUBLIC_BASE_URL=

# Resend
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
RUN_SHEET_INBOUND_EMAIL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Seed (pnpm seed — scripts/seed.ts, run once against a real Supabase project)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUNDAY_PIN=
